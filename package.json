{
  "name": "mytodo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply mytodo --local",
    "test": "vitest run"
  },
  "dependencies": {
    "lunar-javascript": "^1.7.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@cloudflare/vite-plugin": "^1.15.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.46.0",
    "vite": "^7.2.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.4"
  }
}
